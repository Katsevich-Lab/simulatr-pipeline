/*
 * Slurm-specific overrides.
 *
 * 1. Array submission. Nextflow >= 24.04 collapses many independent tasks
 *    into a single Slurm array submission; this drops scheduler overhead
 *    from one job per (method, grid_row, chunk) to one array per process.
 * 2. Layer-2 memory accounting. afterScript dumps sacct numbers into
 *    .command.memory.tsv per task; the COLLECT_MEMORY process aggregates
 *    them into memory.parquet via bin/collect_memory.R.
 */

process {
    executor = 'slurm'

    withName: 'RUN_SIMULATION_CHUNK' {
        array = params.array_size
    }
    withName: 'RUN_BENCHMARK' {
        array = params.array_size
    }

    afterScript = '''
        if [ -n "${SLURM_JOB_ID:-}" ]; then
            sacct -j "${SLURM_JOB_ID}" \
                  --format JobID,JobName,MaxRSS,MaxVMSize,Elapsed \
                  --noheader --parsable2 \
                  > .command.memory.tsv 2>/dev/null \
                || echo "sacct unavailable" > .command.memory.tsv
        else
            # Non-Slurm fallback: bin/rss_sampler.sh wrote .command.memory.tsv
            # in the script body; nothing to do here.
            true
        fi
    '''
}
