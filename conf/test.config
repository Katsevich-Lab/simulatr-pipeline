/*
 * Minimal end-to-end fixture. Targets ~2 min wall-clock on a laptop
 * runner. The fixture itself is built into tests/build_test_fixture.R
 * which writes tests/data/study_test.rds; the test profile points
 * simulatr_specifier_fp at it.
 */

params {
    simulatr_specifier_fp = "${projectDir}/tests/data/study_test.rds"
    result_dir            = "${launchDir}/results-test"
    result_file_name      = "simulatr_result.rds"

    B                     = 0       // use the study's baked-in B (=4)
    B_check               = 2

    max_gb                = 2
    max_hours             = 0.05    // 3 min
    benchmark_memory      = 1
    benchmark_memory_base = 1
    array_size            = 4
}

process {
    cpus = 1
}
