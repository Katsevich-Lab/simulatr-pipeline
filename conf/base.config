/*
 * Per-process resource defaults. These apply to every executor;
 * conf/slurm.config layers Slurm-specific overrides on top.
 */

process {
    errorStrategy = { task.attempt < 6 && task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 6

    withName: 'CHECK_CONTRACT' {
        memory = '2 GB'
        time   = '5 m'
    }

    withName: 'OBTAIN_BASIC_INFO' {
        memory = '2 GB'
        time   = '15 m'
    }

    withName: 'RUN_BENCHMARK' {
        memory = { "${params.benchmark_memory_base * Math.pow(2, task.attempt - 1)} GB" }
        time   = { "${2 * Math.pow(2, task.attempt - 1)} h" }
    }

    withName: 'RUN_SIMULATION_CHUNK' {
        memory = { "${params.max_gb * Math.pow(2, task.attempt - 1)} GB" }
        time   = { "${params.max_hours * Math.pow(2, task.attempt - 1)} h" }
    }

    withName: 'EVALUATE_METHODS' {
        memory = { "${(6 * Math.pow(2, task.attempt - 1)).toInteger()} GB" }
        time   = { "${(15 * Math.pow(2, task.attempt - 1)).toInteger()} m" }
    }

    withName: 'COLLECT_RESULTS' {
        memory = { "${(6 * Math.pow(2, task.attempt - 1)).toInteger()} GB" }
        time   = { "${(15 * Math.pow(2, task.attempt - 1)).toInteger()} m" }
    }

    withName: 'COLLECT_MEMORY' {
        memory = '2 GB'
        time   = '15 m'
    }

    withName: 'COLLECT_ERRORS' {
        memory = '2 GB'
        time   = '15 m'
    }

    withName: 'COLLECT_BENCHMARKING_RESULTS' {
        memory = { "${(4 * Math.pow(2, task.attempt - 1)).toInteger()} GB" }
        time   = { "${(15 * Math.pow(2, task.attempt - 1)).toInteger()} m" }
    }
}
