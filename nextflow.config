/*
 * simulatr-pipeline Nextflow configuration. Default values are mirrored
 * in nextflow_schema.json; edit both when changing.
 */

manifest {
    name            = 'Katsevich-Lab/simulatr-pipeline'
    author          = 'Eugene Katsevich'
    homePage        = 'https://github.com/Katsevich-Lab/simulatr-pipeline'
    description     = 'Run simulatr studies on Nextflow.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04'
    version         = '1.0.0'
}

params {
    // I/O
    simulatr_specifier_fp = null
    result_dir            = "."
    result_file_name      = "simulatr_result.rds"

    // Replication
    B       = 0
    B_check = 5

    // Resource budget
    max_gb                = 8
    max_hours             = 4
    benchmark_memory      = 1
    benchmark_memory_base = 4
    R_SESSION_GB          = 0.5
    GB_PROPORTION_USED    = 0.9
    array_size            = 200
}

profiles {
    standard {
        process.executor = 'local'
        includeConfig 'conf/base.config'
    }
    test {
        includeConfig 'conf/base.config'
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled = true
        process.container = 'ghcr.io/katsevich-lab/simulatr:latest'
        includeConfig 'conf/base.config'
        includeConfig 'conf/docker.config'
    }
    slurm {
        process.executor = 'slurm'
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
    }
}
